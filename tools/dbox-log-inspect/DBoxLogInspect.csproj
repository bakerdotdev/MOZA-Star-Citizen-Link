<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MozaStarCitizen.DBoxLogInspect</RootNamespace>
    <AssemblyName>DBoxLogInspect</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\StarCitizenTelemetryFrame.cs"
             Link="Telemetry\StarCitizenTelemetryFrame.cs" />
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\IStarCitizenTelemetrySource.cs"
             Link="Telemetry\IStarCitizenTelemetrySource.cs" />
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\DBoxSdkLog\DBoxSdkLogModels.cs"
             Link="Telemetry\DBoxSdkLogModels.cs" />
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\DBoxSdkLog\DBoxSdkXmlLogParser.cs"
             Link="Telemetry\DBoxSdkXmlLogParser.cs" />
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\DBoxSdkLog\DBoxSdkSampleTelemetryMapper.cs"
             Link="Telemetry\DBoxSdkSampleTelemetryMapper.cs" />
    <Compile Include="..\..\src\MozaStarCitizen.App\Telemetry\DBoxSdkLog\DBoxSdkSampleLogTelemetrySource.cs"
             Link="Telemetry\DBoxSdkSampleLogTelemetrySource.cs" />
  </ItemGroup>

</Project>
